NUXT_PUBLIC_API_BASE=http://localhost:3001
# Optional Basic authentication for the backend's non-API screens only.
BACKEND_BASIC_AUTH_USER=
BACKEND_BASIC_AUTH_PASSWORD=

CORS_ORIGINS=http://localhost:3000,https://johokyonin-lab.netlify.app
DATABASE_URL=postgres://postgres:postgres@db:5432/tqce_development

# Paid membership is disabled until every Stripe and seller field below is set.
PAID_MEMBERSHIP_ENABLED=false
STRIPE_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FRONTEND_URL=http://localhost:3000

# Opt-in API error notifications; configure only after separate production approval.
ERROR_NOTIFICATIONS_ENABLED=false
SENTRY_ERROR_DSN=
ERROR_NOTIFICATION_ENVIRONMENT=verification

# Public seller information shown on /commercial-disclosure.
NUXT_PUBLIC_SELLER_NAME=
NUXT_PUBLIC_SELLER_REPRESENTATIVE=
NUXT_PUBLIC_SELLER_ADDRESS=
NUXT_PUBLIC_SELLER_PHONE=
NUXT_PUBLIC_SELLER_EMAIL=
# public requires a published address and phone; on_request never publishes them.
SELLER_CONTACT_DISCLOSURE_MODE=public
# Set true only after confirming pre-purchase disclosure requests can be answered promptly.
SELLER_CONTACT_DISCLOSURE_READY=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tqce_development
