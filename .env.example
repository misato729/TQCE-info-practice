# Local Nuxt/Nitro development. Existing .env values are never overwritten.
COMPOSE_PROJECT_NAME=tqce-info-practice
FRONTEND_PORT=3000
API_PORT=3001
DB_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-development-password
# Original database is kept on the legacy Compose profile and its original volume.
POSTGRES_DB=tqce_development
DB_NAME=tqce_nuxt_development
# Empty uses PG*/DB_* settings; production receives a separate URL through Fly secrets.
DATABASE_URL=
NUXT_PUBLIC_API_BASE=
NUXT_API_BASE_INTERNAL=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-an-independent-random-secret-of-at-least-64-characters-before-use

# Existing sales settings are retained during migration; this is not sales approval.
PAID_MEMBERSHIP_ENABLED=false
STRIPE_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional API error notifications.
ERROR_NOTIFICATIONS_ENABLED=false
SENTRY_ERROR_DSN=
ERROR_NOTIFICATION_ENVIRONMENT=verification

# Public seller information shown on /commercial-disclosure.
NUXT_PUBLIC_SELLER_NAME=
NUXT_PUBLIC_SELLER_REPRESENTATIVE=
NUXT_PUBLIC_SELLER_ADDRESS=
NUXT_PUBLIC_SELLER_PHONE=
NUXT_PUBLIC_SELLER_EMAIL=
SELLER_CONTACT_DISCLOSURE_MODE=public
SELLER_CONTACT_DISCLOSURE_READY=false
